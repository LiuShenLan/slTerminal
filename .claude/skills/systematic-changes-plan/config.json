{
  "project": {
    "name": "slTerminal",
    "defaultBranch": "main"
  },
  "commands": {
    "build": "cargo build -p slterm --bin slterm -p slterm_hook --bin slterm-hook",
    "clippy": "cargo clippy --workspace --all-targets",
    "clippyUi": "cargo clippy -p slterm --all-targets --features gpui-test-support",
    "fmtCheck": "cargo fmt --all -- --check",
    "test": "cargo test --workspace -- --test-threads=1",
    "testUi": "cargo test -p slterm --test lib_tests --features gpui-test-support -- --test-threads=1",
    "testPty": "cargo test -p slterm_terminal --test pty_integration_tests -- --test-threads=1",
    "architecture": "python scripts/check_architecture.py",
    "docPolicy": "python scripts/check_doc_policy.py full",
    "brand": "python scripts/check_brand_regress.py staged",
    "scriptTests": "python -m unittest discover -s scripts/tests -p \"test_*.py\"",
    "packageTests": "pwsh -File scripts/tests/package-release.tests.ps1"
  },
  "modules": {
    "app": { "root": "slterm_app/", "extensions": [".rs"] },
    "terminal": { "root": "slterm_terminal/", "extensions": [".rs"] },
    "settings": { "root": "slterm_settings/", "extensions": [".rs"] },
    "split": { "root": "slterm_split/", "extensions": [".rs"] },
    "completions": { "root": "slterm_completions/", "extensions": [".rs"] },
    "hook": { "root": "slterm_hook/", "extensions": [".rs"] },
    "scripts": { "root": "scripts/", "extensions": [".py", ".ps1", ".iss"] },
    "docs": { "root": ".claude/docs/", "extensions": [".md"] }
  },
  "architecture": {
    "constraints": [
      "application → core 单向依赖；core 不依赖 app 或渲染包",
      "渲染框架包禁入 core/hook 生产依赖",
      "模块不穿透，crate 内共享只经公开小接口，跨 crate 只经 core 公开 API",
      "平台分支只在 PTY/平台封装模块",
      "GPUI 前台禁阻塞 I/O、网络、子进程等待",
      "持久化一律临时文件 + rename；设置写只经 settings_store/audit",
      "凭据只存 Windows 凭据管理器，token 不出凭据域",
      "审计事件只经 tracing target audit",
      "配色与布局单点，仅暗色",
      "tab/侧栏为封闭枚举，单一注册点",
      "改动的可自动化部分必须有测试覆盖，不可自动化部分登记豁免"
    ]
  },
  "workflow": {
    "maxParallelAgents": 5,
    "fixMaxRetries": 3,
    "commitPerStage": true,
    "useWorktree": false,
    "gitAddPaths": [
      "slterm_app/",
      "slterm_terminal/",
      "slterm_settings/",
      "slterm_split/",
      "slterm_completions/",
      "slterm_hook/",
      "scripts/",
      "architecture/",
      ".claude/",
      "CONTEXT.md",
      "Cargo.toml",
      "Cargo.lock",
      "CHANGELOG.md",
      "README.md",
      "README.zh-CN.md",
      "release-notes/"
    ],
    "forbiddenZones": [
      "ConPTY flags 默认矩阵不得擅自翻转；任何 0x8 启用须真实 claude 全屏 TUI 滚轮与 Win10 build 阈值人工实测",
      "真实凭据值不得写入任何 git 追踪文件",
      "设置写不得绕过 settings_store/audit 包装",
      "禁止在 GPUI 前台线程执行阻塞 I/O、网络或子进程等待"
    ]
  }
}
