{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ControlMessage",
  "description": "当前请求、响应与发现记录的根集合，schema 与各领域 DTO 共用此边界。",
  "anyOf": [
    {
      "$ref": "#/$defs/JsonRpcRequest"
    },
    {
      "$ref": "#/$defs/JsonRpcRequest2"
    },
    {
      "$ref": "#/$defs/RuntimeRequest"
    },
    {
      "$ref": "#/$defs/JsonRpcResult"
    },
    {
      "$ref": "#/$defs/JsonRpcResult2"
    },
    {
      "$ref": "#/$defs/JsonRpcResult3"
    },
    {
      "$ref": "#/$defs/EventNotification"
    },
    {
      "$ref": "#/$defs/JsonRpcErrorResponse"
    },
    {
      "$ref": "#/$defs/DiscoveryRecord"
    }
  ],
  "$defs": {
    "AgentListResponse": {
      "description": "agent.list 与 agent.get 共用的关联集合；空集合表示没有匹配。",
      "type": "object",
      "properties": {
        "agents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AgentResource"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "agents"
      ]
    },
    "AgentResource": {
      "description": "活跃 Agent 关联：一个对外身份可关联多个终端。\n\n有原生会话 ID 时 `agent_id = kind:native_session_id`，否则按\n`kind@terminal_id`；写方法必须再提供 TerminalId 与 PTY 代次唯一定位。",
      "type": "object",
      "properties": {
        "agent_id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "native_session_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "project_id": {
          "type": "string"
        },
        "status": {
          "description": "封闭状态：`idle`、`working`、`blocked`、`done` 或 `unknown`。",
          "type": "string"
        },
        "terminal_id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "agent_id",
        "terminal_id",
        "project_id",
        "kind",
        "status"
      ]
    },
    "Capabilities": {
      "description": "当前客户端可调用的方法集合。",
      "type": "object",
      "properties": {
        "methods": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false,
      "required": [
        "methods"
      ]
    },
    "ControlScope": {
      "description": "Runtime 与 handover 使用独立授权的同名作用域。",
      "type": "string",
      "enum": [
        "runtime",
        "handover"
      ]
    },
    "Credential": {
      "description": "线缆凭据只参与序列化与认证比较，调试输出永远脱敏。",
      "type": "string"
    },
    "DescribeResponse": {
      "description": "`runtime.describe` 返回方法注册与当前合同散列。",
      "type": "object",
      "properties": {
        "methods": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MethodDescriptor"
          }
        },
        "protocol_sha256": {
          "type": "string"
        },
        "schema_sha256": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "protocol_sha256",
        "schema_sha256",
        "methods"
      ]
    },
    "DiscoveryRecord": {
      "description": "本机控制面发现记录；认证材料只经凭据门面独立获取。",
      "type": "object",
      "properties": {
        "endpoint": {
          "type": "string"
        },
        "process_created_at_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "process_id": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "protocol_version": {
          "type": "integer",
          "format": "uint32",
          "enum": [
            2
          ],
          "minimum": 0
        },
        "run_id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "endpoint",
        "run_id",
        "process_id",
        "process_created_at_ms"
      ]
    },
    "DocumentResource": {
      "description": "快照中的 Document 位置元数据；不含正文。",
      "type": "object",
      "properties": {
        "document_id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "document_id",
        "path"
      ]
    },
    "DomainErrorCode": {
      "description": "结构化领域错误码，不与 JSON-RPC 数值码混用。",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "not_ready",
            "unauthorized",
            "queue_full",
            "closing",
            "invalid_request"
          ]
        },
        {
          "description": "幂等键已绑定其他方法、参数版本或参数散列。",
          "type": "string",
          "const": "mutation_conflict"
        },
        {
          "description": "`expected_revision` 与执行前复核的资源代次不一致。",
          "type": "string",
          "const": "revision_conflict"
        },
        {
          "description": "破坏操作缺少显式处置策略；调用方须使用新 mutation_id 重试。",
          "type": "string",
          "const": "decision_required"
        },
        {
          "description": "副作用无法证明；Operation 为可查询终态，禁止自动重发。",
          "type": "string",
          "const": "outcome_unknown"
        },
        {
          "description": "查询的操作标识不存在。",
          "type": "string",
          "const": "unknown_operation"
        },
        {
          "description": "事件续传三元组不匹配或历史缺口；客户端必须重新快照后订阅。",
          "type": "string",
          "const": "resync_required"
        },
        {
          "description": "分页游标非法、越界或资源代次／revision 已变化；客户端必须重新读取。",
          "type": "string",
          "const": "stale_cursor"
        },
        {
          "description": "对外 Agent 身份没有匹配关联。",
          "type": "string",
          "const": "unknown_agent"
        }
      ]
    },
    "EmptyParams": {
      "description": "无参数的 Runtime 方法；未知字段一律拒绝。",
      "type": "object",
      "additionalProperties": false
    },
    "EventNotification": {
      "description": "服务器到客户端的事件通知；客户端不得回复，连接只承载订阅事件。",
      "type": "object",
      "properties": {
        "jsonrpc": {
          "type": "string",
          "enum": [
            "2.0"
          ]
        },
        "method": {
          "type": "string",
          "enum": [
            "events.event"
          ]
        },
        "params": {
          "$ref": "#/$defs/RuntimeEvent"
        }
      },
      "additionalProperties": false,
      "required": [
        "jsonrpc",
        "method",
        "params"
      ]
    },
    "EventsSubscribeParams": {
      "description": "事件续传三元组：世代与起点必须同时匹配事件环，否则要求重新快照。",
      "type": "object",
      "properties": {
        "since_revision": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "store_epoch": {
          "type": "string"
        },
        "stream_epoch": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "store_epoch",
        "stream_epoch",
        "since_revision"
      ]
    },
    "EventsSubscribedResponse": {
      "description": "订阅确认：返回事件流身份与该订阅看到的当前末尾 revision。",
      "type": "object",
      "properties": {
        "revision": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "stream_epoch": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "stream_epoch",
        "revision"
      ]
    },
    "EventsUnsubscribedResponse": {
      "description": "取消订阅的确认；订阅身份绑定连接，不另行分配。",
      "type": "object",
      "additionalProperties": false
    },
    "GitDiffResponse": {
      "description": "Git diff 页面；`next_cursor` 存在即表示尾部仍有内容。",
      "type": "object",
      "properties": {
        "data": {
          "type": "string"
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": "string"
        },
        "project_id": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "project_id",
        "path",
        "revision",
        "data"
      ]
    },
    "GitStatusEntry": {
      "description": "单个工作区条目的 porcelain v2 状态。",
      "type": "object",
      "properties": {
        "conflict": {
          "type": "boolean"
        },
        "ignored": {
          "type": "boolean"
        },
        "index": {
          "type": "string"
        },
        "original": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "description": "仓库相对路径（`/` 分隔）。",
          "type": "string"
        },
        "staged": {
          "type": "boolean"
        },
        "unstaged": {
          "type": "boolean"
        },
        "worktree": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "path",
        "index",
        "worktree",
        "conflict",
        "ignored",
        "staged",
        "unstaged"
      ]
    },
    "GitStatusResponse": {
      "description": "项目仓库状态：分支、上游与完整条目集，不含正文。",
      "type": "object",
      "properties": {
        "ahead": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "behind": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "branch": {
          "type": "string"
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GitStatusEntry"
          }
        },
        "head": {
          "type": "string"
        },
        "project_id": {
          "type": "string"
        },
        "root": {
          "type": "string"
        },
        "upstream": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "project_id",
        "root",
        "branch",
        "head",
        "ahead",
        "behind",
        "entries"
      ]
    },
    "HandoverMethod": {
      "description": "单实例移交只接受 instance.handover。",
      "type": "string",
      "enum": [
        "instance.handover"
      ]
    },
    "HandoverParams": {
      "description": "第二实例结构化意图；路径授权由应用层 PathPolicy 复核。",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "focus"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "open_project"
            },
            "project_root": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "project_root"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "open_file"
            },
            "path": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "path"
          ]
        },
        {
          "type": "object",
          "properties": {
            "cwd": {
              "type": [
                "string",
                "null"
              ]
            },
            "kind": {
              "type": "string",
              "const": "new_terminal"
            },
            "project_root": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        }
      ]
    },
    "HandoverResponse": {
      "description": "单实例移交已接受的确认；拒绝必须使用结构化错误而非 accepted=false。",
      "type": "object",
      "properties": {
        "accepted": {
          "type": "boolean",
          "enum": [
            true
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "accepted"
      ]
    },
    "HelloMethod": {
      "description": "首包只接受 Runtime hello。",
      "type": "string",
      "enum": [
        "runtime.hello"
      ]
    },
    "HelloParams": {
      "description": "runtime.hello 的认证与协议协商参数。",
      "type": "object",
      "properties": {
        "client_id": {
          "type": "string"
        },
        "credential": {
          "$ref": "#/$defs/Credential"
        },
        "protocol_version": {
          "type": "integer",
          "format": "uint32",
          "enum": [
            2
          ],
          "minimum": 0
        },
        "scope": {
          "$ref": "#/$defs/ControlScope"
        }
      },
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "client_id",
        "credential",
        "scope"
      ]
    },
    "HelloResponse": {
      "description": "hello 握手返回的世代、事件起点与合同散列。",
      "type": "object",
      "properties": {
        "capabilities": {
          "$ref": "#/$defs/Capabilities"
        },
        "protocol_sha256": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "schema_sha256": {
          "type": "string"
        },
        "store_epoch": {
          "type": "string"
        },
        "stream_epoch": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "store_epoch",
        "stream_epoch",
        "revision",
        "protocol_sha256",
        "schema_sha256",
        "capabilities"
      ]
    },
    "JsonRpcError": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "data": {
          "anyOf": [
            {
              "$ref": "#/$defs/JsonRpcErrorData"
            },
            {
              "type": "null"
            }
          ]
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ]
    },
    "JsonRpcErrorData": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/DomainErrorCode"
        }
      },
      "additionalProperties": false,
      "required": [
        "code"
      ]
    },
    "JsonRpcErrorResponse": {
      "description": "通用错误响应的静态形状，不包含任何 result 字段。",
      "type": "object",
      "properties": {
        "error": {
          "$ref": "#/$defs/JsonRpcError"
        },
        "id": {
          "$ref": "#/$defs/JsonRpcId"
        },
        "jsonrpc": {
          "type": "string",
          "enum": [
            "2.0"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "jsonrpc",
        "id",
        "error"
      ]
    },
    "JsonRpcId": {
      "description": "JSON-RPC 请求标识；通知与空标识不属于本协议。",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer",
          "format": "int64"
        }
      ]
    },
    "JsonRpcRequest": {
      "description": "带封闭方法类型的 JSON-RPC 请求信封。",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/JsonRpcId"
        },
        "jsonrpc": {
          "type": "string",
          "enum": [
            "2.0"
          ]
        },
        "method": {
          "$ref": "#/$defs/HelloMethod"
        },
        "params": {
          "$ref": "#/$defs/HelloParams"
        }
      },
      "additionalProperties": false,
      "required": [
        "jsonrpc",
        "id",
        "method",
        "params"
      ]
    },
    "JsonRpcRequest2": {
      "description": "带封闭方法类型的 JSON-RPC 请求信封。",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/JsonRpcId"
        },
        "jsonrpc": {
          "type": "string",
          "enum": [
            "2.0"
          ]
        },
        "method": {
          "$ref": "#/$defs/HandoverMethod"
        },
        "params": {
          "$ref": "#/$defs/HandoverParams"
        }
      },
      "additionalProperties": false,
      "required": [
        "jsonrpc",
        "id",
        "method",
        "params"
      ]
    },
    "JsonRpcResult": {
      "description": "hello 成功响应的静态形状，与通用错误响应严格分离。",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/JsonRpcId"
        },
        "jsonrpc": {
          "type": "string",
          "enum": [
            "2.0"
          ]
        },
        "result": {
          "$ref": "#/$defs/HelloResponse"
        }
      },
      "additionalProperties": false,
      "required": [
        "jsonrpc",
        "id",
        "result"
      ]
    },
    "JsonRpcResult2": {
      "description": "hello 成功响应的静态形状，与通用错误响应严格分离。",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/JsonRpcId"
        },
        "jsonrpc": {
          "type": "string",
          "enum": [
            "2.0"
          ]
        },
        "result": {
          "$ref": "#/$defs/HandoverResponse"
        }
      },
      "additionalProperties": false,
      "required": [
        "jsonrpc",
        "id",
        "result"
      ]
    },
    "JsonRpcResult3": {
      "description": "hello 成功响应的静态形状，与通用错误响应严格分离。",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/JsonRpcId"
        },
        "jsonrpc": {
          "type": "string",
          "enum": [
            "2.0"
          ]
        },
        "result": {
          "$ref": "#/$defs/RuntimeResult"
        }
      },
      "additionalProperties": false,
      "required": [
        "jsonrpc",
        "id",
        "result"
      ]
    },
    "MethodDescriptor": {
      "description": "`runtime.describe` 的单个方法合同：与注册表共用同一事实。",
      "type": "object",
      "properties": {
        "idempotent": {
          "type": "boolean"
        },
        "kind": {
          "$ref": "#/$defs/MethodKind"
        },
        "method": {
          "type": "string"
        },
        "scopes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ControlScope"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "method",
        "scopes",
        "kind",
        "idempotent"
      ]
    },
    "MethodKind": {
      "description": "方法读写类别：查询无副作用，写操作必须携带幂等语义。",
      "type": "string",
      "enum": [
        "query",
        "mutation"
      ]
    },
    "MutationParams": {
      "description": "写请求信封：幂等键与客户端身份是必填，期望代次可选。",
      "type": "object",
      "properties": {
        "client_id": {
          "type": "string"
        },
        "expected_revision": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "mutation_id": {
          "type": "string"
        },
        "request": {
          "$ref": "#/$defs/ProjectActivateRequest"
        }
      },
      "additionalProperties": false,
      "required": [
        "client_id",
        "mutation_id",
        "request"
      ]
    },
    "MutationParams10": {
      "description": "写请求信封：幂等键与客户端身份是必填，期望代次可选。",
      "type": "object",
      "properties": {
        "client_id": {
          "type": "string"
        },
        "expected_revision": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "mutation_id": {
          "type": "string"
        },
        "request": {
          "$ref": "#/$defs/EmptyParams"
        }
      },
      "additionalProperties": false,
      "required": [
        "client_id",
        "mutation_id",
        "request"
      ]
    },
    "MutationParams11": {
      "description": "写请求信封：幂等键与客户端身份是必填，期望代次可选。",
      "type": "object",
      "properties": {
        "client_id": {
          "type": "string"
        },
        "expected_revision": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "mutation_id": {
          "type": "string"
        },
        "request": {
          "$ref": "#/$defs/TerminalCreateRequest"
        }
      },
      "additionalProperties": false,
      "required": [
        "client_id",
        "mutation_id",
