{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主窗口权限声明",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "opener:default",
    "dialog:default",
    "clipboard-manager:allow-write-text",
    "clipboard-manager:allow-read-text",
    "notification:default",
    "allow-ping",
    "allow-get-windows-build-number",
    "allow-set-project-root",
    "allow-pty-spawn",
    "allow-pty-write",
    "allow-pty-resize",
    "allow-pty-kill",
    "allow-fs-read-file",
    "allow-fs-write-file",
    "allow-fs-read-dir",
    "allow-fs-create-dir",
    "allow-fs-delete",
    "allow-fs-rename",
    "allow-save-settings",
    "allow-load-settings",
    "allow-save-projects",
    "allow-load-projects",
    "allow-git-status",
    "allow-git-diff",
    "allow-git-file-at-head",
    "allow-git-rollback",
    "allow-git-unstage",
    "allow-notify-watch",
    "allow-agent-hooks-inject",
    "allow-agent-hooks-uninstall",
    "allow-agent-hooks-injection-status",
    "allow-agent-hooks-restore-statusline",
    "allow-agent-hooks-config-read",
    "allow-agent-hooks-config-write",
    "allow-agent-history-scan",
    "allow-agent-history-delete",
    "allow-agent-history-read-title"
  ]
}
